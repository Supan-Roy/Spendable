# Spendable Environment Template (Root & Railway)
APP_NAME="Spendable API"
APP_VERSION="0.1.0"
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# CORS settings (In single-container deployment, frontend and backend share the origin)
CORS_ORIGINS=["*"]

# Database Configuration (Railway automatically injects DATABASE_URL when PostgreSQL is attached)
# Local Dev Default: sqlite:///./spendable.db
# PostgreSQL Prod: postgresql://postgres:password@localhost:5432/railway
DATABASE_URL=sqlite:///./spendable.db
DATA_PROVIDER=database

# JWT Authentication Secret (Change to a secure random string in production)
JWT_SECRET=spendable-production-jwt-secret-key-replace-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend API Base URL Configuration (Default '/api/v1' for relative origin)
VITE_API_URL=/api/v1

# Gemini AI Integration (Optional: Add your Gemini API key for live AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
