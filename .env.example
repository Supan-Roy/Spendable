# Spendable Environment Template for Railway / Production
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS settings (In unified single-container deployment, frontend and backend share the origin)
CORS_ORIGINS=["*"]

# Database Configuration (Railway automatically sets DATABASE_URL when PostgreSQL plugin is provisioned)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# JWT Authentication Secret (Change to a strong random string in production)
JWT_SECRET=spendable-production-jwt-secret-key-replace-me

# Gemini AI Integration (Optional: Add your Gemini API key for live AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
