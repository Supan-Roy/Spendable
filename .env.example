# Root Environment Template for Spendable
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=spendable_user
POSTGRES_PASSWORD=spendable_pass
POSTGRES_DB=spendable_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://spendable_user:spendable_pass@localhost:5432/spendable_db

# Frontend API Endpoint Configuration
VITE_API_URL=http://localhost:8000

# Planned AI Integration Secrets (Placeholder - DO NOT COMMIT REAL KEYS)
GEMINI_API_KEY=your_gemini_api_key_here
