# Root Environment Template for Spendable
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Application Database Configuration (Default SQLite for local dev, PostgreSQL for Railway prod)
DATABASE_URL=sqlite:///./spendable.db

# Frontend API Endpoint Configuration
VITE_API_URL=http://localhost:8000

# Planned AI Integration Secrets (Placeholder - DO NOT COMMIT REAL KEYS)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
